<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pins restore to a single, explicit source.

    Without this, restore inherits whatever the machine has configured. On a
    default Visual Studio install that is nuget.org plus a local
    "Microsoft Visual Studio Offline Packages" folder. Two sources combined
    with Central Package Management is what NuGet raises NU1507 for, and it
    makes restore non-deterministic: which source a package resolves from
    depends on the machine rather than on this repository.

    <clear /> drops the inherited sources, and the source mapping below states
    explicitly that every package comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
