<Project Sdk="Microsoft.NET.Sdk">

  <!--
    All I/O lives here: the OData client, session resolution, resilience
    pipeline and the caching decorator. Implements ports owned by Application.
  -->

  <ItemGroup>
    <ProjectReference Include="..\TripPin.Application\TripPin.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      SessionUriHandler.Rebase is the URI-rewriting rule and needs direct
      tests, but it is not part of this assembly's contract. Exposed to the
      test project rather than made public.
    -->
    <InternalsVisibleTo Include="TripPin.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
